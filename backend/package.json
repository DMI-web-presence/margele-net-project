{
  "name": "margele-net-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "backup:db": "node scripts/backup-db.js",
    "backup:db:offsite": "node scripts/backup-db.js && node scripts/upload-backup-r2.js --latest",
    "backup:decrypt": "node scripts/decrypt-backup.js",
    "backup:key": "node scripts/generate-backup-key.js",
    "backup:prune": "node scripts/prune-backups.js",
    "backup:restore": "node scripts/restore-db.js",
    "backup:send-alert": "node scripts/send-backup-alert.js",
    "backup:test-restore": "node scripts/test-restore.js",
    "backup:upload-r2": "node scripts/upload-backup-r2.js --latest",
    "db:hardening": "node scripts/db-hardening-report.js",
    "db:migrate": "node scripts/migrate.js",
    "import:categories": "node scripts/import-categories.js",
    "import:customers": "node scripts/import-customers.js",
    "import:orders": "node scripts/import-orders.js",
    "import:product-images": "node scripts/import-product-images.js",
    "import:product-options": "node scripts/import-product-options.js",
    "import:products": "node scripts/import-products.js",
    "migration:validate": "node scripts/validate-migration.js",
    "apply:curated-categories": "node scripts/apply-curated-categories.js",
    "seed:smartbill-mock": "node scripts/seed-smartbill-mock.js",
    "seed:smartbill-mock:remove": "node scripts/seed-smartbill-mock.js --remove",
    "admin:set-user": "node scripts/set-admin-user.js",
    "security:audit": "node scripts/audit-security-config.js",
    "security:r2-lifecycle": "node scripts/configure-r2-lifecycle.js",
    "test": "node --test",
    "dev": "node scripts/kill-dev-port.js 3001 && node src/server.js",
    "start": "node src/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/lib-storage": "^3.1093.0",
    "pg": "^8.20.0",
    "sharp": "^0.35.3"
  }
}
