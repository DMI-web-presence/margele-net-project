PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/margele_net
JWT_SECRET=replace-with-a-secure-random-string
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:3001

# Product image storage mode: local | r2 | auto
# local = always save to backend/uploads
# r2 = only save to Cloudflare R2 and fail if it does not work
# auto = try R2 first, then fall back to local storage
PRODUCT_IMAGE_STORAGE=auto

# Optional: Cloudflare R2 product image storage
# If these are omitted, uploads continue to use local backend/uploads storage.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Example: https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Example: https://img.margele.net
R2_PUBLIC_BASE_URL=
R2_REGION=auto

# SmartBill Cloud API
SMARTBILL_ENABLED=false
SMARTBILL_BASE_URL=https://ws.smartbill.ro/SBORO/api
SMARTBILL_EMAIL=
SMARTBILL_TOKEN=
SMARTBILL_COMPANY_VAT_CODE=
SMARTBILL_INVOICE_SERIES=
SMARTBILL_TAX_NAME=Normala
SMARTBILL_TAX_PERCENTAGE=21
SMARTBILL_DUE_DAYS=0
SMARTBILL_SEND_EMAIL=false

# Netopia Payments Settings
NETOPIA_MODE=sandbox
NETOPIA_API_KEY=your_netopia_api_key_here
NETOPIA_POS_SIGNATURE=your_pos_signature_here
NETOPIA_NOTIFY_TOKEN=generate_a_random_secret_token_here
NETOPIA_EMAIL_TEMPLATE=
NETOPIA_LANGUAGE=ro
